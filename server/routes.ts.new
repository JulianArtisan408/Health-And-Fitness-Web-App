import type { Express, Request, Response, NextFunction } from "express";
import { createServer, type Server } from "http";
import { storage } from "./storage";
import axios from "axios";
import { z } from "zod";
import { format } from "date-fns";
import { citySearchSchema, weatherSchema } from "@shared/schema";

export async function registerRoutes(app: Express): Promise<Server> {
  // Weather API endpoint
  app.get("/api/weather", async (req: Request, res: Response) => {
    try {
      // Validate query parameters
      const query = citySearchSchema.parse({
        city: req.query.city as string,
      });
      
      const unit = req.query.unit === "fahrenheit" ? "imperial" : "metric";
      
      // Fetch weather data from OpenWeatherMap API
      const apiKey = process.env.OPENWEATHERMAP_API_KEY;
      if (!apiKey) {
        return res.status(500).json({ message: "OpenWeatherMap API key not configured" });
      }
      
      console.log(`Using OpenWeatherMap API key: ${apiKey.substring(0, 4)}...${apiKey.substring(apiKey.length - 4)}`);
      
      const weatherResponse = await axios.get(
        `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(query.city)}&appid=${apiKey}&units=${unit}`
      );
      
      const data = weatherResponse.data;
      
      // Calculate daytime progress percentage
      const now = new Date().getTime() / 1000; // Current time in seconds
      const sunrise = data.sys.sunrise;
      const sunset = data.sys.sunset;
      let daytimeProgress = 0;
      
      if (now < sunrise) {
        daytimeProgress = 0;
      } else if (now > sunset) {
        daytimeProgress = 100;
      } else {
        daytimeProgress = Math.round(((now - sunrise) / (sunset - sunrise)) * 100);
      }
      
      // Format response according to our schema
      const weatherData = {
        location: {
          name: data.name,
          country: data.sys.country,
          lat: data.coord.lat,
          lon: data.coord.lon,
        },
        weather: {
          temp: Math.round(data.main.temp),
          feelsLike: Math.round(data.main.feels_like),
          description: data.weather[0].description,
          icon: data.weather[0].icon,
          humidity: data.main.humidity,
          wind: Math.round(unit === "metric" ? data.wind.speed * 3.6 : data.wind.speed), // Convert m/s to km/h if metric
          pressure: data.main.pressure,
          visibility: Math.round(data.visibility / 1000), // Convert m to km
          sunrise: formatTime(data.sys.sunrise * 1000),
          sunset: formatTime(data.sys.sunset * 1000),
          daytimeProgress: daytimeProgress,
        },
        date: format(new Date(), "EEEE, MMM d, yyyy"),
        time: format(new Date(), "h:mm a"),
      };
      
      // Validate the response with our schema
      const validatedData = weatherSchema.parse(weatherData);
      
      return res.json(validatedData);
    } catch (error) {
      console.error("Weather API error:", error);
      
      if (axios.isAxiosError(error)) {
        if (error.response?.status === 404) {
          return res.status(404).json({ message: "City not found" });
        }
        
        if (error.response?.status === 401) {
          console.error("OpenWeatherMap API key error:", error.response.data);
          return res.status(401).json({ 
            message: "Invalid API key or API key not yet activated. OpenWeatherMap API keys may take up to 24 hours to activate after creation."
          });
        }

        // Pass through the original error message from OpenWeatherMap if available
        if (error.response?.data?.message) {
          return res.status(error.response.status).json({
            message: `API Error: ${error.response.data.message}`
          });
        }
      }
      
      if (error instanceof z.ZodError) {
        return res.status(400).json({ 
          message: "Invalid request parameters",
          errors: error.errors 
        });
      }
      
      return res.status(500).json({ message: "Failed to fetch weather data" });
    }
  });

  const httpServer = createServer(app);
  return httpServer;
}

// Format timestamp to readable time
function formatTime(timestamp: number): string {
  return format(new Date(timestamp), "h:mm a");
}